{% extends 'base.html.twig' %}

{% block title %}{{ product.title }}{% endblock %}

{% block body %}

<div class="card">
    <div class="my-3 mx-2 mx-md-2">
        <div class="card-header text-center">
            <h1 class="mb-3">{{ product.title }}</h1>
            <hr class="w-50 mx-auto">
            <p class="mb-0">{{ product.category.name }}</p>
        </div>

        <div class="card-body">

            {% if product.images|length > 0 %}

                <div id="carouselProduct" class="carousel slide mb-4">
                    <div class="carousel-inner">

                        {% for image in product.images %}
                            <div class="carousel-item {% if loop.first %}active{% endif %}">
                                <img src="{{ asset(image.path) }}"
                                    class="d-block mx-auto"
                                    alt="{{ image.alt }}"
                                    style="height: 200px; object-fit: cover;">
                            </div>
                        {% endfor %}

                    </div>

                    {% if product.images|length > 1 %}
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselProduct" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>

                        <button class="carousel-control-next" type="button" data-bs-target="#carouselProduct" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    {% endif %}
                </div>

            {% else %}

                <div class="d-flex justify-content-center align-items-center w-100 mb-4 bg-secondary"
                    style="height: 200px; font-size: 5rem;">
                    🚫
                </div>

            {% endif %}

            <p>{{ product.description }}</p>

        </div>

        <div class="card-footer d-flex flex-column flex-md-row justify-content-around gap-3">

            <span class="badge rounded-pill bg-primary px-5 py-3">
                {{ product.price }} €
            </span>

            <a href="#" class="badge rounded-pill bg-secondary border border-warning text-decoration-none px-5 py-3">
                Ajouter au panier
            </a>

        </div>
    </div>
</div>

{% endblock %}