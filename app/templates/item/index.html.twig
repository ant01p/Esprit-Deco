{% extends 'base.html.twig' %}

{% block body %}

    <h1 class="text-center mb-4">Nos produits</h1>

    {% set badgeColors = ['primary', 'secondary', 'success', 'info', 'warning', 'danger'] %}

    <div class="text-center mb-4">
        <a href="{{ path('app_item_index') }}"
           class="badge text-bg-light me-1 mb-1 text-decoration-none fs-6 {% if currentCategoryId == 0 %}border border-2 border-white fw-bold{% endif %}">
            Toutes les catégories
        </a>
        {% for cat in categories %}
            {% set color = badgeColors[loop.index0 % 6] %}
            <a href="{{ path('app_item_index', {category: cat.id}) }}"
               class="badge text-bg-{{ color }} me-1 mb-1 text-decoration-none fs-6 {% if currentCategoryId == cat.id %}border border-2 border-white fw-bold{% endif %}">
                {{ cat.name }}
            </a>
        {% endfor %}
    </div>

    <div class="row g-4">
        {% for product in products %}

            {% set image = product.images|first %}

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">

                    <a href="{{ path('product_show', {
                        id: product.id,
                        back: path('app_item_index')
                    }) }}" class="text-decoration-none text-white">
                        <h3 class="card-header text-center">
                            {{ product.title }}
                        </h3>
                    </a>

                    {% if image %}
                        <img src="{{ asset(image.path) }}" alt="{{ image.alt }}" class="product-img">

                    {% else %}
                        <div class="no-img">🚫</div>
                    {% endif %}
                    
                    <div class="card-body">
                        <p class="card-text">
                            {{ product.description|slice(0, 160) }}
                            {% if product.description|length > 160 %}. . .{% endif %}
                        </p>
                    </div>
                
                    <div class="card-footer text-muted d-flex flex-column flex-md-row align-items-center justify-content-md-between">
    
                        <span class="mb-2 mb-md-0">
                            {{ product.category.name }}
                        </span>

                        <span class="badge rounded-pill bg-primary px-3">
                            {{ product.price|number_format(2, ',', ' ') }} €
                        </span>

                    </div>
                </div>
            </div>

        {% else %}
            <p class="text-center">Aucun produit</p>
        {% endfor %}
    </div>

{% endblock %}