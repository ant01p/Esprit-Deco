<div class="offcanvas offcanvas-end" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel" style="width: 700px;">

    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="cartOffcanvasLabel">Mon Panier</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">

        {% set cart = cartHandler.getCart() %}
        {% set total = 0 %}

        {% if cart is empty %}

            <p class="text-center">Votre panier est vide.</p>

        {% else %}

            <table class="table table-hover ">

                <tbody>
                    {% for item in cart %}
                        {% set lineTotal = item.product.price * item.quantity %}
                        {% set total = total + lineTotal %}

                        <tr class="table-secondary">
                            <td>
                                {{ item.product.title }}
                                <span>
                                    ({{ item.product.price|number_format(2, ',', ' ') }} €)
                                </span>
                            </td>

                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2">

                                    <button class="btn btn-sm btn-primary rounded-circle 
                                        d-flex justify-content-center align-items-center" 
                                        style="width: 20px; height: 20px;">
                                        -
                                    </button>

                                    <span class="mx-2">{{ item.quantity }}</span>

                                    <button class="btn btn-sm btn-primary rounded-circle 
                                        d-flex justify-content-center align-items-center" 
                                        style="width: 20px; height: 20px;">
                                        +
                                    </button>
                                </div>
                            </td>

                            <td>
                                {{ lineTotal|number_format(2, ',', ' ') }} €
                            </td>
                        </tr>
                    {% endfor %}

                    <tr class="table-dark">
                        <td text-start>
                            <button class="badge rounded-pill bg-primary">Vider le panier</button>
                        </td>

                        <td class="fw-bold">
                            TOTAL
                        </td>

                        <td class="fw-bold">
                            {{ total|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>
                </tbody>

            </table>

            <div class="text-end">
                <button class="btn btn-primary">Payer</button>
            </div>

        {% endif %}

    </div>
</div>