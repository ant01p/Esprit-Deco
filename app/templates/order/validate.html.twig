{% extends 'base.html.twig' %}

{% block title %}Validation de la commande{% endblock %}

{% block body %}

    {% set cart = cartHandler.getCart() %}
    {% set total = cartHandler.getTotal() %}

    <div class=" ">

        <div class="container">

            <h1 class="text-center mb-4">
                Validation de la commande
            </h1>

            <h2 class=" fs-4 mb-2">
                Récapitulatif de votre commande
            </h2>

            <table class="table table-striped align-middle mb-4">
                <tbody>

                    {% for item in cart %}

                        <tr class="table-secondary">
                            <td>
                                {{ item.product.title }}
                            </td>

                            <td class="text-end">
                                {{ item.quantity }} x {{ item.product.price|number_format(2, ',', ' ') }} €
                            </td>

                            <td class="text-end">
                                {{ item.lineTotal|number_format(2, ',', ' ') }} €
                            </td>
                        </tr>
                    {% endfor %}

                    <tr class="table-default fw-bold">
                        <td colspan="2" class="text-end">
                            TOTAL
                        </td>

                        <td class="text-end">
                            {{ total|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="card border-secondary mb-3">

                <div class="card-header px-3 py-2">
                    <h2 class="fs-4 mb-0">
                        Adresse de livraison
                    </h2>
                </div>

                <div class="card-body bg-secondary px-3 py-3">
                    {% if order.address is defined and order.address %}
                        <p class="mb-1">
                            {{ app.user.firstname|default(app.user.email) }}
                        </p>

                        <p class="mb-1">
                            {{ order.address.street }}
                        </p>

                        <p class="mb-0">
                            {{ order.address.zipcode }} {{ order.address.city }}
                        </p>
                    {% else %}
                        <p class="mb-0">
                            Aucune adresse de livraison renseignée.
                        </p>
                    {% endif %}
                </div>

            </div>

            <div class="d-flex justify-content-between align-items-center">

                <a href="{{ path('app_order_delivery_address') }}" class="btn btn-secondary btn-sm">
                    Modifier l’adresse de livraison
                </a>

                <a href="#" class="btn btn-primary btn-sm">
                    Confirmer
                </a>
            </div>
        </div>
    </div>
</div>

{% endblock %}